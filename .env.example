# Copy to .env for local development. Do not commit real values.
# Every variable the app reads is documented here (TASK-033).

# ─── Required ──────────────────────────────────────────────────────────────
# App refuses to start without it.
SECRET_KEY=replace-with-a-long-random-secret

# ─── Database ──────────────────────────────────────────────────────────────
# Primary PostgreSQL (read + write).
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/study_planner
# Optional comma-separated read-replica URIs. Empty = reads go to the
# primary too (the common case). See TASK-039 / app/repositories/base.py.
DATABASE_REPLICA_URLS=

# ─── Redis ─────────────────────────────────────────────────────────────────
# Application data cache (TASK-025). Empty = no caching, reads hit the DB.
REDIS_URL=
# Rate-limiter storage. Empty/memory:// = in-memory (single process only).
RATELIMIT_STORAGE_URI=memory://

# ─── Security (TASK-029) ───────────────────────────────────────────────────
# Set true in production behind TLS; leave false for local plain-HTTP dev.
SESSION_COOKIE_SECURE=false
# HSTS max-age seconds, applied to every response. Ignored by browsers
# without TLS. Default 31536000 (1 year).
HSTS_MAX_AGE=31536000

# ─── Runtime ───────────────────────────────────────────────────────────────
FLASK_DEBUG=true

# ─── LibreTranslate (optional translation feature) ─────────────────────────
LIBRETRANSLATE_URL=http://localhost:5001
LIBRETRANSLATE_API_KEY=

# ─── Sentry (optional error monitoring) ────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
